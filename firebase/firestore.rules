rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validBooking() {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.paymentStatus in ['pending', 'verified', 'failed']
        && request.resource.data.bookingStatus in ['pending', 'confirmed', 'cancelled', 'completed'];
    }

    match /users/{userId} {
      allow read, update: if owns(userId) || isAdmin();
      allow create: if owns(userId);
    }
    match /admins/{adminId} { allow read, write: if isAdmin(); }
    match /turfs/{turfId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sports/{sportId} { allow read: if true; allow write: if isAdmin(); }
    match /slots/{slotId} { allow read: if true; allow write: if isAdmin(); }
    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && validBooking();
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'cancelledAt'])
        && request.resource.data.bookingStatus == 'cancelled');
    }
    match /payments/{paymentId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Trusted backend only via Admin SDK.
    }
    match /favorites/{favoriteId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /coupons/{couponId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, delete: if isAdmin();
    }
  }
}
