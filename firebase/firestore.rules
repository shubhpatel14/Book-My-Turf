rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function enabled() {
      return signedIn() && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == false);
    }
    function admin() { return enabled() && request.auth.token.get('admin', false) == true; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function reservedAfter(slotId, bookingId, turfId, day) {
      let reservation = getAfter(/databases/$(database)/documents/reservations/$(slotId));
      return reservation != null
        && reservation.data.bookingId == bookingId
        && reservation.data.turfId == turfId
        && reservation.data.day == day;
    }
    function validProfile(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'location', 'disabled'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.location is string && request.resource.data.location.size() <= 300;
    }
    match /users/{uid} {
      allow read: if own(uid) || admin();
      allow create: if own(uid) && validProfile(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.get('disabled', false) == false;
      allow update: if validProfile(uid) && (
        (own(uid) && enabled() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'location']))
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled'])));
      match /favorites/{turfId} {
        allow read, delete: if own(uid) && enabled();
        allow create, update: if own(uid) && enabled() && request.resource.data.keys().hasOnly(['turfId']) && request.resource.data.turfId == turfId;
      }
    }
    match /turfs/{id} {
      allow read: if admin() || (enabled() && resource.data.active == true);
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['name','area','city','sports','pricePerHour','rating','distanceKm','description','facilities','isIndoor','active','visualSeed','photoUris','imageUrls','openingHour','closingHour'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.pricePerHour is int && request.resource.data.pricePerHour > 0 && request.resource.data.pricePerHour <= 1000000
        && request.resource.data.rating is number && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.distanceKm is number && request.resource.data.distanceKm >= 0
        && request.resource.data.sports is list && request.resource.data.sports.size() > 0
        && request.resource.data.photoUris is list && request.resource.data.photoUris.size() <= 4
        && (!('imageUrls' in request.resource.data) || (request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() <= 4))
        && request.resource.data.openingHour is int && request.resource.data.openingHour >= 0
        && request.resource.data.closingHour is int && request.resource.data.closingHour <= 23
        && request.resource.data.closingHour > request.resource.data.openingHour
        && request.resource.data.active is bool && request.resource.data.isIndoor is bool;
      allow delete: if admin();
    }
    match /slots/{id} {
      allow read: if enabled();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['turfId','date','day','time','price','state'])
        && request.resource.data.price is int && request.resource.data.price > 0 && request.resource.data.price <= 1000000
        && request.resource.data.state in ['AVAILABLE','BLOCKED'];
      allow delete: if admin();
    }
    match /reservations/{id} {
      allow read: if enabled();
      allow create: if enabled()
        && !exists(/databases/$(database)/documents/reservations/$(id))
        && request.resource.data.keys().hasOnly(['bookingId','turfId','day','date','time','price'])
        && request.resource.data.price is int && request.resource.data.price > 0
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotIds.hasAny([id]);
      allow delete: if admin() || (enabled()
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.status == 'CANCELLED');
      allow update: if false;
    }
    match /bookings/{id} {
      allow read: if enabled() && (admin() || resource.data.userId == request.auth.uid);
      allow create: if enabled()
        && request.resource.data.keys().hasOnly(['id','userId','turfId','turfName','date','day','time','startHour','durationHours','amount','status','customer','paymentMethod','paymentStatus','transactionId','slotIds','createdAt'])
        && request.resource.data.id == id && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'CONFIRMED'
        && request.resource.data.paymentMethod == 'DEMO_UPI'
        && request.resource.data.paymentStatus == 'DEMO_PAID'
        && request.resource.data.transactionId is string && request.resource.data.transactionId.matches('BMT-DEMO-[A-Z0-9]{8}')
        && request.resource.data.durationHours is int && request.resource.data.durationHours >= 1 && request.resource.data.durationHours <= 4
        && request.resource.data.slotIds is list && request.resource.data.slotIds.size() == request.resource.data.durationHours
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && reservedAfter(request.resource.data.slotIds[0], id, request.resource.data.turfId, request.resource.data.day)
        && (request.resource.data.durationHours < 2 || reservedAfter(request.resource.data.slotIds[1], id, request.resource.data.turfId, request.resource.data.day))
        && (request.resource.data.durationHours < 3 || reservedAfter(request.resource.data.slotIds[2], id, request.resource.data.turfId, request.resource.data.day))
        && (request.resource.data.durationHours < 4 || reservedAfter(request.resource.data.slotIds[3], id, request.resource.data.turfId, request.resource.data.day));
      allow update: if admin() || (enabled() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'CANCELLED');
      allow delete: if admin();
    }
    match /notifications/{id} {
      allow read: if enabled() && resource.data.userId == request.auth.uid;
      allow create: if enabled() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','title','message','time','unread','type'])
        && request.resource.data.unread == true && request.resource.data.type == 'booking'
        && getAfter(/databases/$(database)/documents/bookings/$(id)).data.userId == request.auth.uid;
      allow update: if enabled() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unread'])
        && request.resource.data.unread == false;
    }
    match /offers/{id} {
      allow read: if admin() || (enabled() && resource.data.active == true);
      allow write: if admin();
    }
    match /reviews/{id} {
      allow read: if admin() || (enabled() && resource.data.published == true);
      allow write: if admin();
    }
    match /config/public {
      allow read: if enabled();
      allow write: if admin() && request.resource.data.keys().hasOnly(['acceptBookings']) && request.resource.data.acceptBookings is bool;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
