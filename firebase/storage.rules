rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function enabled() {
      return request.auth != null && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('disabled', false) == false);
    }
    function admin() { return enabled() && request.auth.token.get('admin', false) == true; }
    match /turf-images/{turfId}/{fileName} {
      allow read: if enabled();
      allow create, update: if admin() && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if admin();
    }
    match /{path=**} { allow read, write: if false; }
  }
}
